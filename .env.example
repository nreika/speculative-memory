# Generation archive: one folder per capture (<root>/<YYYY-MM-DD>/<generationId>/) holding
# <id>_NOW.jpg, <id>_A.png.., <id>_prompts.json, <id>_README.txt. Images show real people:
# point this OUTSIDE the public repository. Default shown below.
GENERATION_ARCHIVE_DIR=C:\Users\nmrei\GitHub\speculative-memory_data\generations

# ImageSharpen alpha at the end of the ComfyUI workflow. 0 = off (recommended: alpha 0.2 produced a screen-door grid on skin and hair, 2026-10-16).
COMFYUI_SHARPEN_ALPHA=0

# Reference frames (lightweight identity consistency, no face embedding). When true, every frame with a person is kept
# downscaled under REF_FRAMES_DIR, and up to REF_FRAMES_MAX recent frames (last REF_FRAMES_WINDOW_MIN minutes) whose
# orientation differs from the current frame are passed to ComfyUI as image2/image3 (local backend, frames with a person).
# Real people appear in these files: keep REF_FRAMES_DIR OUTSIDE the public repo. POST /api/reset-history moves them to <dir>/_archive/.
REF_FRAMES_ENABLED=false
REF_FRAMES_MAX=2
REF_FRAMES_WINDOW_MIN=10
REF_FRAMES_MAX_PX=768
REF_FRAMES_DIR=C:\Users\nmrei\GitHub\speculative-memory_data\ref-frames

# Continuous local QA (Qwen via Ollama, free) + automatic rulebook improvement: see docs/RULEBOOK.md.
# QA runs only between captures (never while one generates; a new capture aborts a running QA call).
QA_LOCAL_ENABLED=true
# QA_LOCAL_MODEL=qwen3-vl:4b-instruct   # default: VLM_MODEL
# Also judge while ComfyUI renders the images (the laptop's Ollama is idle then). Default false = strictly between captures.
QA_DURING_IMAGE_STAGE=false
QA_AUTO_IMPROVE=true
QA_IMPROVE_EVERY=30
QA_ROLLBACK_DELTA=0.05
